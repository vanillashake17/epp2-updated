@startuml seq_lidar
skinparam backgroundColor white
skinparam defaultFontName "Helvetica"
skinparam sequenceArrowColor #444444
skinparam sequenceArrowFontColor #666666
skinparam sequenceLifeLineBorderColor #aaaaaa
skinparam sequenceLifeLineBackgroundColor white
skinparam participantBackgroundColor #e8e8e8
skinparam participantBorderColor #888888
skinparam participantFontColor #222222
skinparam activationBarBackgroundColor #d0d0d0
skinparam activationBarBorderColor #888888
skinparam noteBackgroundColor #f0f0f0
skinparam noteBorderColor #aaaaaa
skinparam noteFontColor #333333
hide footbox

title LiDAR / SLAM Flow

participant "<<device>>\nRPLidar A1" as lidar
participant ":lidar.py" as lidardrv
participant ":lidar_forwarder" as fwd
participant ":slam_client" as client
participant ":matplotlib" as ui

fwd -> lidardrv : connect()
activate lidardrv
lidardrv -> lidar : reset / start motor
lidar --> lidardrv : ready
lidardrv --> fwd : lidar handle
deactivate lidardrv

client -> fwd : TCP connect

loop continuous scan
  lidar --> lidardrv : raw scan round
  lidardrv --> fwd : angles, distances

  fwd -> fwd : resample to 360 bins

  fwd -> client : JSON scan [TCP]

  activate client
  client -> client : SLAM update & get pose

  client -> ui : render map & point cloud
  activate ui
  ui --> client : draw
  deactivate ui
  deactivate client
end

@enduml
