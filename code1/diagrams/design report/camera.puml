@startuml seq_camera
skinparam backgroundColor white
skinparam defaultFontName "Helvetica"
skinparam sequenceArrowColor #444444
skinparam sequenceArrowFontColor #666666
skinparam sequenceLifeLineBorderColor #aaaaaa
skinparam sequenceLifeLineBackgroundColor white
skinparam participantBackgroundColor #e8e8e8
skinparam participantBorderColor #888888
skinparam participantFontColor #222222
skinparam activationBarBackgroundColor #d0d0d0
skinparam activationBarBorderColor #888888
skinparam noteBackgroundColor #f0f0f0
skinparam noteBorderColor #aaaaaa
skinparam noteFontColor #333333
hide footbox

title Camera Command Flow

actor "Operator" as op
participant ":pi_sensor" as pi
participant ":alex_camera" as cam
participant "<<device>>\nPiCamera2" as hw

op -> pi : stdin: "command"
activate pi

pi -> pi : handleCameraCommand()
activate pi
deactivate pi

alt E-Stop active
  pi --> op : "E-Stop is active."
else no frames remaining
  pi --> op : "No frames remaining."
else frames available
  pi -> cam : captureGreyscaleFrame(...)
  activate cam
  cam -> hw : capture still
  activate hw
  hw --> cam : raw frame
  deactivate hw
  cam -> cam : convert to greyscale
  cam --> pi : greyscale frame
  deactivate cam

  pi -> cam : renderGreyscaleFrame(...)
  activate cam
  cam -> cam : map pixels to ANSI codes
  cam --> pi : printed to stdout
  deactivate cam

  pi -> pi : _frames_remaining -= 1
  pi --> op : "Frames remaining: N"
  deactivate pi
end

@enduml
