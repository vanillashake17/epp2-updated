@startuml arch_system
skinparam backgroundColor white
skinparam defaultFontName "Helvetica"
skinparam ArrowColor #444444
skinparam ArrowFontColor #666666
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 55
skinparam padding 8

skinparam rectangle {
  BackgroundColor #fce8e8
  BorderColor #cc6666
  FontColor #222222
}

skinparam node {
  BackgroundColor #fff7e0
  BorderColor #b58900
  FontColor #222222
}

skinparam component {
  BackgroundColor #ffffff
  BorderColor #888888
  FontColor #222222
  Style rectangle
}

title System Architecture

' ==================== Peripherals attached to Arduino ====================
node "<<device>>\n8x AA Batteries" as batt
node "<<device>>\nServo Arm\nBase / Shoulder / Elbow / Gripper" as servo
node "<<device>>\nAFMotor Shield\n(L293D, 4x DC motors)" as motors
node "<<device>>\nColour Sensor\nTCS3200" as color_sensor
node "<<device>>\nE-Stop Button" as estop_btn

' ==================== Arduino Mega (ATMega2560) ====================
rectangle "<<device>> ATMega2560" as arduino_box #fce8e8 {

  rectangle "Controls Algorithm" as ctrl_grp #ffe0e0 {
    component "Servo Control\n«Timer 5 PWM, 20 ms»" as ctrl_servo
    component "Motor Control\n«robotlib.ino, AFMotor»" as ctrl_motor
  }

  rectangle "Sensor Algorithm" as sens_grp #ffe0e0 {
    component "Colour Detection\n«Timer 2 CTC, 100 us»" as sens_color
    component "E-Stop Handler\n«INT1 ISR, any-edge»" as sens_estop
  }

  rectangle "Communications Protocol\n«packets.h»" as comms_grp #ffe0e0 {
    component "Packet Handler" as a_handler
    component "Packet Serialiser\n«TPacket + XOR»" as a_serial
    component "USART0 Driver\n«ISR TX/RX, MAGIC 0xDEAD»" as a_uart
  }
}

batt -down-> arduino_box : 5 V regulated
ctrl_servo -right-> servo : PWM
ctrl_motor -right-> motors : PWM
color_sensor -left-> sens_color : freq pulses
estop_btn -left-> sens_estop : INT1 (PD1)

a_handler -down-> a_serial
a_serial -down-> a_uart

' ==================== Raspberry Pi (hub) ====================
node "<<device>>\nPower Bank" as pwrbank
node "<<device>>\nRPLidar A1M8" as lidar_dev
node "<<device>>\nPi Camera\n«CSI»" as picam

rectangle "<<device>> Raspberry Pi (mango)" as pi_box #d8eaf8 {

  rectangle "pi_sensor.py — Pi-side hub" as hub_grp #cfe2f5 {
    component "CLI / Operator Loop\n«WASD, arm, color, camera»" as pi_cli
    component "Serial Bridge\n«USB serial @ 9600»" as pi_serial
    component "Camera Wrapper\n«alex_camera.py»\n«ASCII 80x44»" as pi_cam
    component "Color State Manager" as pi_color
  }

  rectangle "TLS Relay" as relay_grp #cfe2f5 {
    component "relay.py\n«TLS TCP :65432»\n«TLS 1.2 min, server.crt»" as pi_relay
    component "net_utils.py\n«4-byte length-prefix framing»" as pi_net
  }

  rectangle "LiDAR / SLAM Pipeline" as lidar_grp #cfe2f5 {
    component "lidar_forwarder.py\n«JSON scans @ TCP :5002»" as pi_fwd
    component "slam/lidar.py\n«resample to 360 bins»" as pi_lidar
    component "lidar/alex_lidar.py\n«PyRPLidar wrapper»" as pi_alex_lidar
    component "slam/settings.py" as pi_settings
  }

  component "packets.py\n«shared TPacket constants»" as pi_packets
}

pwrbank -down-> pi_box : 5 V USB
picam -down-> pi_cam : CSI ribbon
lidar_dev -down-> pi_alex_lidar : USB serial

pi_cli -down-> pi_serial
pi_cli -down-> pi_cam
pi_cli -down-> pi_color
pi_cli -right-> pi_relay : embed (in-process)

pi_relay -down-> pi_net
pi_relay -up-> pi_packets

pi_alex_lidar -down-> pi_lidar
pi_lidar -down-> pi_fwd
pi_lidar -down-> pi_settings
pi_fwd -down-> pi_settings

' Arduino <-> Pi serial link
a_uart <-right-> pi_serial : USB UART\n«TPacket frames»

' ==================== Thin clients ====================
rectangle "<<device>> Thin Client — Motion Operator" as motion_client #e8f8e8 {
  component "SSH session into Pi\n«runs pi_sensor.py»" as motion_ssh
  component "Terminal\n«ASCII camera + CLI»" as motion_term
  motion_ssh -down-> motion_term
}

rectangle "<<device>> Thin Client — Arm Operator / Supervisor" as arm_client #e8f8e8 {
  component "second_terminal.py\n«TLS TCP client»" as st_main
  component "net_utils.py\n«length-prefix framing»" as st_net
  component "packets.py\n«TPacket constants»" as st_packets
  st_main -down-> st_net
  st_main -down-> st_packets
}

rectangle "<<device>> Thin Client — SLAM Visualiser" as slam_client_box #e8f8e8 {
  component "slam_client.py\n«TCP :5002»" as sc_main
  component "BreezySLAM\n«RMHC_SLAM»" as sc_slam
  component "matplotlib\n«dual / full map view»" as sc_ui
  sc_main -down-> sc_slam
  sc_slam -down-> sc_ui
}

' Pi <-> clients
pi_box <-up- motion_ssh : SSH
pi_relay <-right-> st_main : TLS TCP :65432\n«encrypted TPacket + length prefix»
pi_fwd -right-> sc_main : TCP :5002\n«JSON 360-bin scans»

legend bottom
  | Colour | Meaning |
  | <#fce8e8> | Arduino (firmware) |
  | <#d8eaf8> | Raspberry Pi (Python) |
  | <#e8f8e8> | Thin client (operator side) |
  | <#fff7e0> | Hardware device |
  Encryption: Pi <-> Arm/Supervisor terminal uses TLS 1.2 (cert: certs/server.crt, hostname 'mango').
  Lidar telemetry stream (TCP :5002) is unencrypted by design (one-way scan data, LAN-local).
endlegend

@enduml
