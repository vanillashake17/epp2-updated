@startuml System_Architecture_Diagram
skinparam dpi 200
skinparam backgroundColor white
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowFontColor #555555
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.2
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55
skinparam padding 8
skinparam roundCorner 8
skinparam shadowing false

skinparam rectangle {
  BackgroundColor #fce8e8
  BorderColor #cc6666
  FontColor #222222
  FontStyle bold
}
skinparam node {
  BackgroundColor #fff7e0
  BorderColor #b58900
  FontColor #222222
}
skinparam component {
  BackgroundColor #ffffff
  BorderColor #888888
  FontColor #222222
  FontStyle plain
  Style rectangle
}

title <b>System Architecture</b>\n<size:11><i>Source: submission-code branch (code/ tree)</i></size>

' ========================================================================
' Top: peripherals (Arduino-side on left, Pi-side on right)
' ========================================================================
together {
  node "8x AA\nBattery"        as batt
  node "DC Motors\n(4x L293D)" as mt
  node "Servo Arm\n(4-DOF)"    as sv
  node "TCS3200\nColour"       as tcs
  node "E-Stop\nButton"        as eb
}

together {
  node "Power\nBank"      as pb
  node "Pi Camera\n(CSI)" as pc
  node "RPLidar\nA1M8"    as rpl
}

' ========================================================================
' ATMega2560 firmware (left) — code/alex_firmware/*.ino
' ========================================================================
rectangle "<<device>>  ATMega2560 — code/alex_firmware/" as arduino #fce8e8 {
  rectangle "Controls" as ctrl #ffe0e0 {
    component "Motor Control\n«robotlib.ino»"        as cm
    component "Servo Control (Arm)\n«arm.ino, Timer 5 PWM, 20 ms»" as cs
    cm -right- cs
  }
  rectangle "Sensors                                                    " as sens #ffe0e0 {
    component "Colour Driver\n«color_sensor.ino, Timer 2 CTC, 100 us»" as sc
    component "E-Stop ISR\n«estop.ino, INT1»"                          as se
    sc -right- se
  }
  rectangle "Comms (packets.h)" as ac #ffe0e0 {
    component "Handler +\nSerialiser\n«alex_firmware.ino»" as ah
    component "USART0 Driver\n«serial_driver.h, ISR, MAGIC 0xDEAD»" as au
    ah -right- au
  }
  ctrl -[hidden]down- sens
  sens -[hidden]down- ac
}

' ========================================================================
' Raspberry Pi (right) — code/ Python tree
' ========================================================================
rectangle "<<device>>  Raspberry Pi (mango) — code/ (Python)" as pi #d8eaf8 {
  rectangle "pi_sensor.py — Hub" as hub #cfe2f5 {
    component "Serial Bridge\n«USB @ 9600 bps»"                            as sb
    component "CLI / Loop\n«WASD, colour, camera, E-Stop»\n«arm moved to second_terminal»" as cli
    component "alex_camera.py\n«ASCII 80x44, gated by E-Stop»"             as cam
    sb -right- cli
    cli -right- cam
  }
  rectangle "TLS Relay (in-process)" as relay #cfe2f5 {
    component "second_terminal/relay.py\n«TLS TCP :65432, TLS 1.2»" as rl
    component "second_terminal/net_utils.py\n«4-byte length prefix»" as nu
    component "packets.py\n«TPacket consts»"                          as pp
    rl -right- nu
    nu -right- pp
  }
  rectangle "LiDAR / SLAM Pipeline" as lp #cfe2f5 {
    component "pyrplidar/\n«vendored driver pkg»"          as pyr
    component "slam/lidar.py\n«scan_rounds(), 360 bins»"   as sl
    component "slam/lidar_forwarder.py\n«JSON @ TCP :5002»" as lf
    pyr -right- sl
    sl -right- lf
  }
  hub -[hidden]down- relay
  relay -[hidden]down- lp
}

' Force Arduino LEFT of Pi
arduino -[hidden]right- pi

' ========================================================================
' Bottom: network clients
' ========================================================================
together {
  rectangle "                                       Motion Operator (Pi shell)" as mc #e8f8e8 {
    component "SSH → Pi\nlaunches pi_sensor.py" as ms
    component "Terminal\n«WASD drive + ASCII cam»" as mt2
    ms -right- mt2
  }
  rectangle "Arm Operator / Supervisor" as ac2 #e8f8e8 {
    component "second_terminal.py\n«TLS TCP client, host=mango»" as st
    component "CLI: e, n, b/s/e/g<NNN>,\nv<NNN>, h (home), q" as sn
    st -right- sn
  }
  rectangle "SLAM Visualiser (desktop)" as svp #e8f8e8 {
    component "slam/slam_client.py\n«TCP :5002 client»"      as scm
    component "BreezySLAM (RMHC)\n+ matplotlib display"      as ss
    scm -right- ss
  }
}

' ========================================================================
' Wiring
' ========================================================================
' Arduino peripherals -> Arduino subsystems
batt -down-> arduino
mt   -down-> cm
sv   -down-> cs
tcs  -down-> sc
eb   -down-> se

' Pi peripherals -> Pi subsystems
pb  -down-> pi
pc  -down-> cam
rpl -down-> lp

' Arduino <-> Pi (USB serial bridge)
arduino -right-> pi : USB UART «TPacket, 103-byte frame»

' Pi -> network clients
pi -down-> ms : SSH
rl -down-> st
note on link
 <b>TLS :65432</b>
 «encrypted TPacket»
end note
lf -down-> scm
note on link
 <b>TCP :5002</b>
 «JSON 360-bin scans»
end note

@enduml
