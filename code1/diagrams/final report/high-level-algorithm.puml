@startuml High_Level_Algorithm
title Figure 6-1  High Level Algorithm — Threading Model on RPi and Logic Flow on Clients

skinparam backgroundColor white
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 10
skinparam shadowing false
skinparam ArrowColor #444444
skinparam ArrowFontColor #555555
skinparam ArrowFontSize 9
skinparam nodesep 18
skinparam ranksep 18
skinparam roundCorner 6

skinparam rectangle {
  BackgroundColor #ffffff
  BorderColor #888888
  FontColor #222222
}

' ==============================================================
' LEFT COLUMN — Thin client: SLAM visualiser
' ==============================================================
package "Thin Client (SLAM Visualiser) — slam_client.py" as slam_client #fff3e0 {
  rectangle "Initialisation" as s_init
  rectangle "Data Reception" as s_rx
  rectangle "SLAM Update" as s_upd
  rectangle "Visualisation Update" as s_vis

  note right of s_init
    Parse PI_IP arg, open TCP socket to Pi :5002.
    Create RMHC_SLAM (Laser + MAP_METERS + quality).
    Init matplotlib: dual-panel map + point cloud,
    with "Full Map / Both Maps" view toggle button.
  end note
  note right of s_rx
    Read length-prefixed JSON scan over TCP.
    Fields: 360-bin distances_mm, angles, scan_ok.
  end note
  note right of s_upd
    slam.update(distances, scan_ok).
    x_mm, y_mm, theta_deg = slam.getpos().
    Convert polar (dist, angle) -> Cartesian.
  end note
  note right of s_vis
    imshow occupancy map, scatter point cloud,
    draw robot pose (blue dot + green heading arrow).
    Loop until socket close / user exit.
  end note

  s_init -down-> s_rx
  s_rx -down-> s_upd
  s_upd -down-> s_vis
  s_vis -up-> s_rx : loop
}

' ==============================================================
' LEFT COLUMN — Thin client: Teleop / supervisor
' ==============================================================
package "Thin Client (Teleop) — second_terminal.py" as ctrl_client #f3e5f5 {
  rectangle "Initialisation" as c_init
  rectangle "Connection" as c_conn
  rectangle "User Input" as c_in
  rectangle "Data Processing" as c_dp
  rectangle "Termination" as c_end

  note right of c_init
    Build SSL context (TLS 1.2 min),
    load certs/server.crt, set hostname 'mango'.
  end note
  note right of c_conn
    TCPClient.connect(PI_HOST, 65432).
    TLS handshake, print servo-arm limits.
  end note
  note right of c_in
    Read stdin line (non-blocking select).
    Parse:
      e = E-Stop    n = toggle colour print
      b/s/e/g/v<NNN> = arm    h = home
      q = quit
  end note
  note right of c_dp
    Pack TPacket (MAGIC 0xDEAD + 100 B + XOR).
    sendTPacketFrame() over TLS socket.
    Receive RESP_COLOR / RESP_ARM / STATE frames
    and print to stdout.
  end note
  note right of c_end
    Ctrl+C or 'q': close TLS socket gracefully,
    restore terminal, exit.
  end note

  c_init -down-> c_conn
  c_conn -down-> c_in
  c_in -down-> c_dp
  c_dp -up-> c_in : loop
  c_dp -down-> c_end
}

' ==============================================================
' RIGHT COLUMN — Raspberry Pi hub (pi_sensor.py + relay.py + forwarder)
' ==============================================================
package "Raspberry Pi (mango) — pi_sensor.py hub" as rpi #ffe0e0 {

  rectangle "Main Thread\nrunCommandInterface()\n(stdin CLI loop)" as main_t
  rectangle "_processSerial()\nArduino -> Pi reader\n(RESP_COLOR / STATE / etc.)" as proc_ser
  rectangle "relay.py Thread\nTLS TCP server :65432\nbi-directional forward" as relay_t
  rectangle "handle*Command()\n(Color / Camera / Motor / Arm / E-Stop)" as handlers
  rectangle "alex_camera\n80x44 ASCII,\nE-Stop gated, 15 frames max" as cam_node

  rectangle "lidar_forwarder.py\n(separate process)\nTCP server :5002" as lf
  rectangle "alex_lidar.py\nPyRPLidar wrapper" as al
  rectangle "slam/lidar.py\n360-bin resample" as sl

  main_t -down-> handlers : dispatch
  main_t -down-> proc_ser : poll serial
  handlers -right-> cam_node : 'p' cmd
  handlers -down-> relay_t : sendCommand\n(TPacket via serial)
  proc_ser -up-> main_t : update _estop_state
  relay_t -up-> main_t : forward client\nTPacket frames

  al -down-> sl : raw scan
  sl -down-> lf : 360-bin scan
}

' ==============================================================
' Cross-panel connectors
' ==============================================================
c_dp -right-> relay_t : TLS :65432\nTPacket\n(encrypted)
relay_t -left-> c_dp : RESP_* frames
lf -left-> s_rx : TCP :5002\nJSON 360-bin scan\n(plaintext)

' Legend
legend right
  |= Colour |= Meaning |
  |<#fff3e0>   | SLAM visualiser flow |
  |<#f3e5f5>   | Teleop client flow |
  |<#ffe0e0>   | Raspberry Pi hub |
endlegend

@enduml
